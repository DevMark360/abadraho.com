// Legacy winner-take-all model — retired by AdSlotAllocation (Milestone 18+, time-shared
// rotation). No longer written to; kept only until the new path has run clean in production for
// a few days, then this table and model are dropped in a follow-up cleanup migration.
model AdSlotWinner {
  id           Int      @id @default(autoincrement())
  slotKey      String   @unique @map("slot_key") @db.VarChar(191)
  campaignId   Int      @map("campaign_id")
  effectiveCpm Decimal  @map("effective_cpm") @db.Decimal(12, 2)
  computedAt   DateTime @default(now()) @map("computed_at")
  validUntil   DateTime @map("valid_until")

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([validUntil])
  @@map("ad_slot_winners")
}

// One row per (slot, campaign) currently sharing that slot's 60-second rotation cycle — replaces
// AdSlotWinner's single-winner-per-slot model. shareSeconds is this campaign's allocated seconds
// within the cycle, computed by ad-auction-core.mjs's allocateSlotSeconds. weight is the raw
// maxBidCpm × qualityScore × dailyBudget value that produced it, kept for debugging/transparency
// — not re-derived from it.
model AdSlotAllocation {
  id           Int      @id @default(autoincrement())
  slotKey      String   @map("slot_key") @db.VarChar(191)
  campaignId   Int      @map("campaign_id")
  effectiveCpm Decimal  @map("effective_cpm") @db.Decimal(12, 2)
  weight       Decimal  @map("weight") @db.Decimal(18, 4)
  shareSeconds Int      @map("share_seconds")
  computedAt   DateTime @default(now()) @map("computed_at")
  validUntil   DateTime @map("valid_until")

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([slotKey, campaignId])
  @@index([slotKey, validUntil])
  @@index([validUntil])
  @@map("ad_slot_allocations")
}

