model AdWalletTransaction {
  id                     Int       @id @default(autoincrement())
  walletId               Int       @map("wallet_id")
  type                   String    @db.VarChar(30) // 'topup_bank_transfer' | 'topup_jazzcash' | 'spend' | 'whatsapp_package_purchase' | 'refund_undelivered' | 'adjustment'
  amount                 Decimal   @db.Decimal(15, 2) // signed: positive for topup, negative for spend
  balanceAfter           Decimal?  @map("balance_after") @db.Decimal(15, 2)
  referenceNote          String?   @map("reference_note") @db.Text
  status                 String    @default("pending") @db.VarChar(20) // pending|confirmed|rejected
  // Polymorphic actor reference (like ActivityLog.causerType/causerId) — a "full staff" admin
  // session's id may come from either the `admins` table or the `users` table (see
  // src/lib/admin-rbac.ts getAdminPanelRole), so this intentionally has no FK constraint.
  confirmedByActorSource String?   @map("confirmed_by_actor_source") @db.VarChar(10) // 'admin' | 'user'
  confirmedByActorId     Int?      @map("confirmed_by_actor_id")
  // JazzCash pp_TxnRefNo (or other gateway's transaction reference) for reconciliation — null for bank-transfer/manual entries.
  gatewayReference       String?   @map("gateway_reference") @db.VarChar(40)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime? @updatedAt @map("updated_at")

  wallet AdWallet @relation(fields: [walletId], references: [id])

  @@index([status])
  @@index([walletId])
  @@index([gatewayReference])
  @@map("ad_wallet_transactions")
}

