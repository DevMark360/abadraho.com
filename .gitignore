# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build
.turbo

# Environment & secrets (never commit)
.env
.env.*
!.env.example
!.env.local.example

# Prisma local DB
/prisma/*.db
/prisma/*.db-journal

# Debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing
/coverage
.nyc_output

# TypeScript
*.tsbuildinfo

# Vercel / deploy
.vercel

# IDE / OS
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Playwright / browser automation cache
.playwright-mcp/
/test-results/
/playwright-report/
/blob-report/

# Local DB dumps & import logs (keep data/README.md)
/data/*.sql
/data/*.log
/data/client/

# Script run logs
scripts/*.log

# Prisma client (rebuilt via `npm run postinstall` / `prisma generate`)
/src/generated/

# User-uploaded media (project images, PDFs — sync via FTP / legacy server, not Git)
/public/uploads/

# Misc
*.pem
.cache/

# Build artifacts & logs
build.zip
stderr.log
