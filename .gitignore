# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/
/build
.turbo

# Environment & secrets (never commit)
.env
.env.*
!.env.example
!.env.local.example

# Prisma local DB
/prisma/*.db
/prisma/*.db-journal

# Debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing
/coverage
.nyc_output

# TypeScript
*.tsbuildinfo

# Vercel / deploy
.vercel

# IDE / OS
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Playwright / browser automation cache
.playwright-mcp/
/test-results/
/playwright-report/
/blob-report/

# Local DB dumps & import logs (keep data/README.md)
/data/*.sql
/data/*.log
/data/client/

# Script run logs
scripts/*.log

# Prisma client (rebuilt via `npm run postinstall` / `prisma generate`)
/src/generated/

# Static files & user uploads (images, videos, PDFs, fonts, cPanel's public/.htaccess) live
# on the server only. .cpanel.yml deploys with cp -R, which never deletes them; copy new
# files to the server manually (File Manager / FTP).
/public/*
# 3D illustration icons ship with the code (small, free IconScout assets)
!/public/icons/
/public/icons/*
!/public/icons/3d/
# Small brand marks used in the UI (e.g. Google sign-in)
!/public/icons/brand/

# Misc
*.pem
.cache/

# Build artifacts & logs
build.zip
stderr.log

# Private uploads (wallet payment screenshots) — server only, served via auth-checked routes
/storage/
